# ═══════════════════════════════════════════════════════════
# IG Unified API — Environment Variables
# ═══════════════════════════════════════════════════════════
# Shared settings have NO prefix.
# Service-specific settings use GROWTH_, STATUS_, CHECKER_, TG_ prefixes.
# All values shown are defaults — uncomment and change as needed.

# ── Shared (no prefix) ───────────────────────────────────
# ADB
ADB_PATH=adb
# ADB_HOST=
# ADB_PORT=0
USE_SCRCPY=true
# SCRCPY_PATH=
# ADB_RETRY_COUNT=2
# ADB_RETRY_DELAY=1.0
# WAKE_SCREEN_BEFORE_CHECK=true

# Navigation timing (seconds)
# NAV_STEP_DELAY=1.5
# SCROLL_DELAY=1.0
# PAGE_LOAD_DELAY=2.0
# MAX_SCROLLS_TO_FIND=12

# Proxy app (Super Proxy)
# PROXY_PACKAGE=com.scheler.superproxy
# PROXY_AD_DISMISS_ATTEMPTS=3

# Security
API_KEY=
CORS_ORIGINS=*
# RATE_LIMIT_FORCE=3
# RATE_LIMIT_WHITELIST=

# Debug / dumps
# DEBUG_DUMPS=true
# DEBUG_DUMPS_DIR=dumps
# DEBUG_DUMPS_MAX_FILES=500
# SCREEN_CACHE_TTL=3600

# Telegram (shared token + chat for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=DEBUG

# ── Growth Service (GROWTH_ prefix) ───────────────────────
GROWTH_DB_PATH=data/ig_growth.db
# GROWTH_CHECK_TIMEOUT=240
# GROWTH_MAX_PARALLEL_DEVICES=5
# GROWTH_DB_RETENTION_DAYS=365
GROWTH_SCHEDULER_ENABLED=false
GROWTH_SCHEDULER_DAILY_HOUR=8
GROWTH_SCHEDULER_DAILY_MINUTE=0
# GROWTH_SCHEDULER_TIMEZONE=America/New_York
# GROWTH_TELEGRAM_NOTIFY_MIN_SCORE=70
# GROWTH_TELEGRAM_BOT_ENABLED=false
# GROWTH_VIRAL_RETENTION_DAYS=90
# GROWTH_VIRAL_DEDUP_HOURS=6
# GROWTH_CONTENT_LOOKUP_URL=

# ── Status Service (STATUS_ prefix) ───────────────────────
STATUS_DB_PATH=data/ig_status.db
# STATUS_CHECK_TIMEOUT=180
# STATUS_MAX_PARALLEL_DEVICES=5
# STATUS_DB_RETENTION_DAYS=90
STATUS_SCHEDULER_ENABLED=false
STATUS_SCHEDULER_DAILY_HOUR=7
STATUS_SCHEDULER_DAILY_MINUTE=0
# STATUS_SCHEDULER_TIMEZONE=
# STATUS_TELEGRAM_BOT_ENABLED=false
# STATUS_TELEGRAM_ALERT_ON_PROBLEM=true
# STATUS_TELEGRAM_ALERT_ON_STATE_CHANGE=true

# ── Checker Service (CHECKER_ prefix) ────────────────────
CHECKER_DB_PATH=data/ig_accounts.db
# CHECKER_REQUEST_TIMEOUT=15
# CHECKER_DELAY_MIN=3.0
# CHECKER_DELAY_MAX=8.0
# CHECKER_MAX_RETRIES=2
# CHECKER_USER_AGENT=Mozilla/5.0 ...
CHECKER_PROXY_ENABLED=false
# CHECKER_PROXY_URL=socks5://user:pass@host:port
# CHECKER_PROXY_LIST_FILE=proxies.txt
# CHECKER_PROXY_ROTATE=true
# CHECKER_PROXY_RENEW_URL=http://...
# CHECKER_PROXY_RENEW_EVERY=5
CHECKER_SCHEDULER_ENABLED=false
CHECKER_SCHEDULER_HOUR=8
# CHECKER_SCHEDULER_MINUTE=0
CHECKER_SCHEDULER_INTERVAL_HOURS=12
# CHECKER_TELEGRAM_BOT_ENABLED=false
# CHECKER_TELEGRAM_ALERT_DROP_PCT=5.0
# CHECKER_TELEGRAM_ALERT_GAIN_PCT=20.0
# CHECKER_HISTORY_RETENTION_DAYS=365

# ── Telegram Bot (TG_ prefix) ────────────────────────────
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_API_BASE_URL=http://localhost:8000
TG_API_KEY=
# TG_ALERT_POLL_INTERVAL=60
# TG_LOG_LEVEL=INFO
